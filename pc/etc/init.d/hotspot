#!/sbin/openrc-run
name="hotspot"
description="Intel AX200 5G AP for streaming"
supervisor=supervise-daemon
command="/usr/sbin/hostapd"
command_args="/etc/hostapd/MT7922.conf"
respawn_delay=3
respawn_max=10
respawn_period=300
output_log="/var/log/hotspot.log"
error_log="/var/log/hotspot.log"
depend() {
    need localmount
    before dnsmasq
    after udev 
    use modules

}
start_pre() {
    local i
    for i in $(seq 1 45); do
        [ -d /sys/class/net/wlan_mt7922 ] && break
        sleep 1
    done
    if [ ! -d /sys/class/net/wlan_mt7922 ] ; then
        eerror "wlan_mt7922 not found"
        return 1
    fi
    ip link set wlan_mt7922 down 2>/dev/null || true
    ip addr flush dev wlan_mt7922 2>/dev/null || true
    ip addr add 10.2.2.1/24 dev wlan_mt7922
    ip link set wlan_mt7922 up
}

stop_post() {
    ip addr flush dev wlan_mt7922] 2>/dev/null || true
}
