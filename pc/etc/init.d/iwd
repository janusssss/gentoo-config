pidfile="/run/iwd.pid"
command="/usr/libexec/iwd"
command_background="yes"
command_args="-I wlan_mt9722"

depend() {
	need dbus
	after bootmisc modules
	before dns dhcpcd net
	keyword -shutdown
}
