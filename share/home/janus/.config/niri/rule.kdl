// 粘贴板
window-rule {
    match app-id="shorinclip"
    match app-id="cliphist-tui"
    match app-id="quickterminal"
    default-column-width {
        fixed 625
    }
    default-window-height {
        fixed 700
    }
    //min-height 800
    open-floating true
    default-floating-position x=0 y=18 relative-to="top"
}
window-rule {
    match app-id="firefox"
    match app-id="BambuStudio"
    match app-id="steam_app_1903340"
    match app-id="steam_app_2358720"
    match app-id="steam_app_1091500"
    open-maximized-to-edges true
}
// 背景模糊
window-rule {
    match app-id="foot"
    match app-id="firefox"
    background-effect {
        blur true
    }
}
 // 背景透明
